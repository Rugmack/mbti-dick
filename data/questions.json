{
  "version": "2026-02-03",
  "title": "FC-MBTI / Face-Cock Behavioral Index",
  "disclaimer": "この診断はジョークです。医学・心理学的根拠はありません。結果は演出であり、人格や価値を断定するものではありません。",
  "scoring": {
    "mbti": {
      "axisQuestions": {
        "EI": [1, 2, 3, 4, 5],
        "SN": [6, 7, 8, 9, 10],
        "TF": [11, 12, 13, 14, 15],
        "JP": [16, 17, 18, 19, 20]
      },
      "tiebreaker": "first"
    },
    "fc": {
      "basePointsByOptionKey": { "A": 3, "B": 2, "C": 1, "D": 3 },
      "bonuses": [
        { "ifDominant": "T", "add": 5 },
        { "ifDominant": "J", "add": 5 },
        { "ifMbtiIn": ["ENTJ", "INTJ"], "add": 10 }
      ],
      "stars": [
        { "min": 0, "max": 29, "stars": 1 },
        { "min": 30, "max": 44, "stars": 2 },
        { "min": 45, "max": 59, "stars": 3 },
        { "min": 60, "max": 74, "stars": 4 },
        { "min": 75, "max": 999, "stars": 5 }
      ],
      "params": {
        "notes": "paramsは演出用。exposureはfcScore正規化、awareness/collateralは選択傾向とMBTI補正で算出する想定。",
        "awareness": {
          "base": 50,
          "addPerB": 6,
          "subPerD": 7,
          "clamp": [0, 100]
        },
        "collateral": {
          "base": 20,
          "addPerD": 6,
          "addIfDominantT": 12,
          "addIfDominantJ": 12,
          "clamp": [0, 100]
        },
        "exposure": {
          "normalizeFromFcScore": true,
          "cap": 100
        }
      }
    }
  },
